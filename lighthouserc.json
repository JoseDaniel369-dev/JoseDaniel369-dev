{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/index.html",
        "http://localhost/en/index.html",
        "http://localhost/proyectos/se7en/index.html",
        "http://localhost/en/projects/se7en/index.html",
        "http://localhost/proyectos/jfood/index.html",
        "http://localhost/en/projects/jfood/index.html",
        "http://localhost/aviso-legal/index.html",
        "http://localhost/en/legal/index.html",
        "http://localhost/404.html"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/404\\.html$).*$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.95
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/404\\.html$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
